{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "types": ["node", "react"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "dashboard/**/*.tsx",
    "packages/tui/maestro-tui/src/**/*.tsx"
  ]
}
