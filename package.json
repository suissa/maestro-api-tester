{
  "name": "maestro-api-tester",
  "version": "0.1.0",
  "description": "A small API tester with a natural-language test DSL and OpenTUI dashboard",
  "type": "module",
  "scripts": {
    "build": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dashboard": "bun dashboard/index.tsx",
    "start": "node --experimental-strip-types src/server.ts",
    "test:dashboard": "bun dashboard/tests.tsx",
    "test:dashboard:run": "node --experimental-strip-types --test --test-reporter=spec tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@opentui/core": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
