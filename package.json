{
  "name": "maestro-api-tester",
  "version": "0.1.0",
  "description": "A small API tester with a natural-language test DSL and OpenTUI dashboard",
  "type": "module",
  "scripts": {
    "build": "npm run format:check && npm run lint && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs",
    "dashboard": "bun dashboard/index.tsx",
    "start": "node src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opentui/core": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0"
  }
}
